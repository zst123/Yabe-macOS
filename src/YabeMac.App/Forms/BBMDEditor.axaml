<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="YabeMac.BBMDEditor"
        Title="BBMD Tables Editor"
        Width="440" Height="430" MinWidth="400" MinHeight="360"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Spacing="2" Margin="0,6,0,0">
      <TextBlock x:Name="LbBBMDInfo" Text="Read Broadcast Table without response" Foreground="Red" IsVisible="False" />
      <TextBlock x:Name="LbFDRInfo" Text="Read FDR Table without response" Foreground="Red" IsVisible="False" />
    </StackPanel>
    <TabControl x:Name="TabCtrl">
      <TabControl.Styles><Style Selector="TabItem"><Setter Property="FontSize" Value="13"/></Style></TabControl.Styles>
      <TabItem Header="BroadCast Table">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" HorizontalAlignment="Center">
            <Button Content="Add row" Click="OnAddRow" />
            <Button Content="Delete row" Click="OnDeleteRow" />
            <Button x:Name="BpWrite" Content="Write &amp; Read back" Click="OnWrite" />
          </StackPanel>
          <DataGrid x:Name="BBMDTable" AutoGenerateColumns="False" CanUserResizeColumns="True" GridLinesVisibility="All">
            <DataGrid.Columns>
              <DataGridTextColumn Header="IP Address" Binding="{Binding IPAddress}" Width="150" />
              <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70" />
              <DataGridTextColumn Header="Mask" Binding="{Binding Mask}" Width="150" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="FDR Table">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" Content="Refresh" HorizontalAlignment="Center" Margin="0,6,0,0" Click="OnRefresh" />
          <DataGrid x:Name="FDRTable" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All">
            <DataGrid.Columns>
              <DataGridTextColumn Header="EndPoint" Binding="{Binding IPendpoint}" Width="170" />
              <DataGridTextColumn Header="TTL" Binding="{Binding TTL}" Width="80" />
              <DataGridTextColumn Header="Remain" Binding="{Binding Remain}" Width="80" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
