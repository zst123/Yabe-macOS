<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>YabeMac</RootNamespace>
    <NoWarn>$(NoWarn);CS0618;CS0168;CS0169;CS0219;CS0649;CS4014;CS1998</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.6" />
    <ProjectReference Include="..\..\src\YabeMac.Core\YabeMac.Core.csproj" />
    <Compile Include="..\..\src\YabeMac.App\Properties\*.cs" Link="Properties\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\YabeMac.App\Controls\PropertyTree.cs" Link="Controls\PropertyTree.cs" />
    <Compile Include="..\..\src\YabeMac.App\Forms\PropertyEditors\DateTimeEditor.cs" Link="Forms\PropertyEditors\DateTimeEditor.cs" />
    <Compile Include="..\..\src\YabeMac.App\Infra\AppSettings.cs" Link="Infra\AppSettings.cs" />
  </ItemGroup>
</Project>
