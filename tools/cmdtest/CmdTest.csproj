<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>YabeMac</RootNamespace>
    <StartupObject>CmdTest</StartupObject>
    <NoWarn>$(NoWarn);CS0618;CS0168;CS0169;CS0219;CS0649;CS4014;CS1998</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.6" />
    <!-- the real app assembly: PropertyModel, GlobalCommander model/window, FindPrioritiesGlobal window, dialogs -->
    <ProjectReference Include="..\..\src\YabeMac.App\YabeMac.App.csproj" />
  </ItemGroup>
</Project>
